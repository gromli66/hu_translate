# Скопировать в docker/.env и заполнить. Файл .env в git не попадает.

# Ключ шифрования токенов портала. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеря ключа = сохранённые токены не читаются, пользователи вписывают их заново.
HUT_SECRET_KEY=

# Сколько переводов одновременно на весь сервер (у каждого пользователя всё равно не больше одного).
HUT_MAX_JOBS=3

# 1 — если сервис открыт через HTTPS (обратный прокси); тогда cookie входа уходит только по HTTPS.
HUT_COOKIE_SECURE=0

# Максимальный размер одного загружаемого файла, МБ.
HUT_MAX_UPLOAD_MB=200

# Обслуживание раз в сутки: копия базы в data/backups (сколько хранить), удаление по сроку (0 — не удалять).
# Удаляются файлы задач (исходники и результаты) и старые ответы портала; правки, память и глоссарии остаются.
HUT_BACKUP_KEEP=14
HUT_KEEP_DAYS=0
HUT_CACHE_DAYS=0

HUT_PORT=8010
ROSATOM_AI_BASE=https://go.ai-rosatom.ru
ROSATOM_MODEL=privateLLM
